{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-monitor:report:6",
  "title": "Agent Monitor report v6",
  "description": "One JSONL report. Optional unavailable values are omitted, not zero. Associations describe launch origin, not current shared-daemon causality, except evidence sessionRegistry: the session a runtime hosted when its harness listed it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "attributionMeaning": {
      "const": "launchOrigin"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "intervalSeconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 60,
      "description": "Requested start-to-start acquisition period. Overruns delay the next scan without overlapping or catch-up scans; achieved timing is reported separately."
    },
    "cpuThresholdPercent": {
      "type": "number",
      "minimum": 0
    },
    "memoryThresholdBytes": {
      "type": "integer",
      "minimum": 0
    },
    "sampledProcessCount": {
      "type": "integer",
      "minimum": 0
    },
    "unreadableProcessCount": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/heavyProcess"
      }
    },
    "cpuAccounting": {
      "$ref": "#/$defs/cpuAccounting"
    },
    "observedFindings": {
      "type": "array",
      "description": "Unfiltered contributors in scope during the display window, including historical lifetimes no longer observed in its final scan. Historical memory never enters current totals. Polling can miss workers and final exit CPU.",
      "items": {
        "$ref": "#/$defs/heavyProcess"
      }
    },
    "window": {
      "$ref": "#/$defs/reportWindow",
      "description": "Measured CPU uses unique contributions opening at or after baselineScan and closing in (baselineScan, finalScan], divided by endedAt-startedAt. Earlier openings are recovered CPU-seconds only. Monotonic times use the acquisition run clock. Point labels are frozen per contribution; no interval-supported ownership is asserted. Contributions cover row lifetimes in the requested scope; cpuAccounting.measuredUserPercent separately covers all sampled same-user lifetimes."
    }
  },
  "required": [
    "schemaVersion",
    "attributionMeaning",
    "timestamp",
    "intervalSeconds",
    "cpuThresholdPercent",
    "memoryThresholdBytes",
    "sampledProcessCount",
    "unreadableProcessCount",
    "findings",
    "cpuAccounting",
    "observedFindings"
  ],
  "$defs": {
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "startMicroseconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix process start time in microseconds; PID plus start time identifies a lifetime."
        }
      },
      "required": [
        "pid",
        "startMicroseconds"
      ]
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "evidence": {
          "enum": [
            "marker",
            "inheritedMarker",
            "writerLock",
            "sessionRegistry",
            "runtimeOnly",
            "ambiguous",
            "unknown"
          ]
        },
        "context": {
          "enum": [
            "terminal",
            "nonterminal",
            "unverified"
          ]
        },
        "threadID": {
          "type": "string",
          "format": "uuid"
        },
        "rootSessionID": {
          "type": "string",
          "format": "uuid"
        },
        "runtime": {
          "$ref": "#/$defs/processIdentity"
        },
        "terminal": {
          "type": "string"
        },
        "runtimeDirectory": {
          "type": "string"
        },
        "candidateThreadIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "ancestry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processIdentity"
          }
        }
      },
      "required": [
        "evidence",
        "context",
        "candidateThreadIDs",
        "ancestry"
      ]
    },
    "heavyProcess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "process": {
          "$ref": "#/$defs/processIdentity"
        },
        "executable": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cpuPercent": {
          "type": "number",
          "minimum": 0,
          "description": "Average over actual elapsed time between process observations; 100 means one core. Omitted when unavailable."
        },
        "footprintBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Physical footprint snapshot in bytes, not RSS. Omitted when unavailable."
        },
        "cwd": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadataStatus": {
          "enum": [
            "markerRead",
            "notObserved",
            "unavailable",
            "malformed"
          ]
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "kernelPeakFootprintBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Kernel-reported maximum physical footprint in bytes for the current task. Can reset on exec. Not current memory or a simultaneous session peak. Omitted when unavailable."
        },
        "accounting": {
          "$ref": "#/$defs/processWindowAccounting"
        }
      },
      "required": [
        "process",
        "executable",
        "name",
        "metadataStatus",
        "attribution"
      ]
    },
    "cpuAccounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostBusyPercent": {
          "type": "number",
          "minimum": 0,
          "description": "Unweighted logical-CPU occupancy; 100% = one logical CPU. Omitted when unavailable."
        },
        "logicalCPUCount": {
          "type": "integer",
          "minimum": 1
        },
        "measuredUserPercent": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of measured CPU for listed current-user lifetimes, excluding the monitor; not a complete usage total."
        },
        "unmeasuredLifetimeCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Listed lifetimes without CPU data; does not count never-observed processes."
        },
        "previousScanSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Previous scan duration, bounding newborn window skew. Omitted without a previous scan."
        },
        "acquisition": {
          "$ref": "#/$defs/acquisitionTiming"
        }
      },
      "required": [
        "logicalCPUCount",
        "measuredUserPercent",
        "unmeasuredLifetimeCount"
      ]
    },
    "acquisitionTiming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runID": {
          "type": "string",
          "format": "uuid"
        },
        "scanSequence": {
          "type": "integer",
          "minimum": 0
        },
        "qualityOfService": {
          "enum": [
            "userInitiated"
          ]
        },
        "requestedPeriodSeconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60
        },
        "achievedPeriodSeconds": {
          "type": "number",
          "minimum": 0
        },
        "scanWorkSeconds": {
          "type": "number",
          "minimum": 0
        },
        "resolutionDelaySeconds": {
          "type": "number",
          "minimum": 0
        },
        "promptCapture": {
          "$ref": "#/$defs/promptCaptureSummary"
        }
      },
      "required": [
        "runID",
        "scanSequence",
        "qualityOfService",
        "requestedPeriodSeconds",
        "scanWorkSeconds",
        "resolutionDelaySeconds"
      ]
    },
    "promptCaptureSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captured": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "reservedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "readSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "captured",
        "unavailable",
        "deferred",
        "unsupported",
        "reservedBytes",
        "readSeconds"
      ]
    },
    "processWindowAccounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpuSeconds": {
          "type": "number",
          "minimum": 0
        },
        "recoveredCPUSeconds": {
          "type": "number",
          "minimum": 0
        },
        "pointCandidateCPUSeconds": {
          "type": "number",
          "minimum": 0
        },
        "uncertainCPUSeconds": {
          "type": "number",
          "minimum": 0
        },
        "isHistorical": {
          "type": "boolean"
        },
        "lastObservedAt": {
          "type": "number"
        },
        "lastObservedFootprintBytes": {
          "type": "integer",
          "minimum": 0
        },
        "currentAttribution": {
          "$ref": "#/$defs/attribution"
        }
      },
      "required": [
        "recoveredCPUSeconds",
        "pointCandidateCPUSeconds",
        "uncertainCPUSeconds",
        "isHistorical",
        "lastObservedAt"
      ]
    },
    "frozenCPUContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runID": {
          "type": "string",
          "format": "uuid"
        },
        "openingScan": {
          "type": "integer",
          "minimum": 0
        },
        "closingScan": {
          "type": "integer",
          "minimum": 0
        },
        "process": {
          "$ref": "#/$defs/processIdentity"
        },
        "newbornOpening": {
          "type": "boolean"
        },
        "verifiedBirth": {
          "type": "number"
        },
        "cpuSeconds": {
          "type": "number",
          "minimum": 0
        },
        "startedAt": {
          "type": "number"
        },
        "endedAt": {
          "type": "number"
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "pointEvidenceObservedAt": {
          "type": "number"
        },
        "revision": {
          "const": 1
        }
      },
      "required": [
        "runID",
        "openingScan",
        "closingScan",
        "process",
        "newbornOpening",
        "cpuSeconds",
        "startedAt",
        "endedAt",
        "attribution",
        "revision"
      ]
    },
    "reportWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runID": {
          "type": "string",
          "format": "uuid"
        },
        "baselineScan": {
          "type": "integer",
          "minimum": 0
        },
        "finalScan": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "type": "number"
        },
        "endedAt": {
          "type": "number"
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frozenCPUContribution"
          }
        },
        "excludedObservationCount": {
          "type": "integer",
          "minimum": 0
        },
        "evictedBaselineCount": {
          "type": "integer",
          "minimum": 0
        },
        "unmeasuredLifetimeCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "runID",
        "baselineScan",
        "finalScan",
        "startedAt",
        "endedAt",
        "contributions",
        "excludedObservationCount",
        "evictedBaselineCount",
        "unmeasuredLifetimeCount"
      ]
    }
  }
}
