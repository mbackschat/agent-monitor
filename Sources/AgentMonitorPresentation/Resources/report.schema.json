{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-monitor:report:1",
  "title": "Agent Monitor report v1",
  "description": "One JSONL report. Optional unavailable values are omitted, not zero. Associations describe launch origin, not current shared-daemon causality, except evidence sessionRegistry: the session a runtime hosted when its harness listed it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "attributionMeaning": {
      "const": "launchOrigin"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "intervalSeconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 60,
      "description": "Requested start-to-start acquisition period. Overruns delay the next scan without overlapping or catch-up scans; achieved timing is reported separately."
    },
    "cpuThresholdPercent": {
      "type": "number",
      "minimum": 0
    },
    "memoryThresholdBytes": {
      "type": "integer",
      "minimum": 0
    },
    "sampledProcessCount": {
      "type": "integer",
      "minimum": 0
    },
    "unreadableProcessCount": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/heavyProcess"
      }
    },
    "cpuAccounting": {
      "$ref": "#/$defs/cpuAccounting"
    },
    "observedFindings": {
      "type": "array",
      "description": "Unfiltered contributors in scope during the display window, including historical lifetimes no longer observed in its final scan. Historical memory never enters current totals. Polling can miss workers and final exit CPU.",
      "items": {
        "$ref": "#/$defs/heavyProcess"
      }
    },
    "window": {
      "$ref": "#/$defs/reportWindow",
      "description": "Measured CPU uses unique contributions opening at or after baselineScan and closing in (baselineScan, finalScan], divided by endedAt-startedAt. Earlier openings are recovered CPU-seconds only. Monotonic times use the acquisition run clock. Point labels are frozen per contribution; no interval-supported ownership is asserted. Contributions cover row lifetimes in the requested scope; cpuAccounting.measuredUserPercent separately covers all sampled same-user lifetimes."
    }
  },
  "required": [
    "schemaVersion",
    "attributionMeaning",
    "timestamp",
    "intervalSeconds",
    "cpuThresholdPercent",
    "memoryThresholdBytes",
    "sampledProcessCount",
    "unreadableProcessCount",
    "findings",
    "cpuAccounting",
    "observedFindings"
  ],
  "$defs": {
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "startMicroseconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix process start time in microseconds; PID plus start time identifies a lifetime."
        }
      },
      "required": [
        "pid",
        "startMicroseconds"
      ]
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "evidence": {
          "enum": [
            "marker",
            "inheritedMarker",
            "writerLock",
            "sessionRegistry",
            "runtimeOnly",
            "ambiguous",
            "unknown"
          ]
        },
        "context": {
          "enum": [
            "terminal",
            "nonterminal",
            "unverified"
          ]
        },
        "threadID": {
          "type": "string",
          "format": "uuid"
        },
        "rootSessionID": {
          "type": "string",
          "format": "uuid"
        },
        "runtime": {
          "$ref": "#/$defs/processIdentity"
        },
        "terminal": {
          "type": "string"
        },
        "runtimeDirectory": {
          "type": "string"
        },
        "candidateThreadIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "ancestry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processIdentity"
          }
        }
      },
      "required": [
        "evidence",
        "context",
        "candidateThreadIDs",
        "ancestry"
      ]
    },
    "heavyProcess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "process": {
          "$ref": "#/$defs/processIdentity"
        },
        "executable": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cpuPercent": {
          "type": "number",
          "minimum": 0,
          "description": "Average over actual elapsed time between process observations; 100 means one core. Omitted when unavailable."
        },
        "footprintBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Physical footprint snapshot in bytes, not RSS. Omitted when unavailable."
        },
        "cwd": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadataStatus": {
          "enum": [
            "markerRead",
            "notObserved",
            "unavailable",
            "malformed",
            "truncated"
          ]
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "kernelPeakFootprintBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Kernel-reported maximum physical footprint in bytes for the current task. Can reset on exec. Not current memory or a simultaneous session peak. Omitted when unavailable."
        },
        "accounting": {
          "$ref": "#/$defs/processWindowAccounting"
        }
      },
      "required": [
        "process",
        "executable",
        "name",
        "metadataStatus",
        "attribution"
      ]
    },
    "cpuAccounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostBusyPercent": {
          "type": "number",
          "minimum": 0,
          "description": "Unweighted logical-CPU occupancy; 100% = one logical CPU. Omitted when unavailable."
        },
        "logicalCPUCount": {
          "type": "integer",
          "minimum": 1
        },
        "measuredUserPercent": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of measured CPU for listed current-user lifetimes, excluding the monitor; not a complete usage total."
        },
        "unmeasuredLifetimeCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Exact unless a count range is present; then this scalar is its lower bound."
        },
        "previousScanSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Previous scan duration, bounding newborn window skew. Omitted without a previous scan."
        },
        "acquisition": {
          "$ref": "#/$defs/acquisitionTiming"
        },
        "unmeasuredLifetimeCountRange": {
          "$ref": "#/$defs/lifetimeCountRange"
        }
      },
      "required": [
        "logicalCPUCount",
        "measuredUserPercent",
        "unmeasuredLifetimeCount"
      ]
    },
    "acquisitionTiming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runID": {
          "type": "string",
          "format": "uuid"
        },
        "scanSequence": {
          "type": "integer",
          "minimum": 0
        },
        "qualityOfService": {
          "enum": [
            "userInitiated"
          ]
        },
        "requestedPeriodSeconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60
        },
        "achievedPeriodSeconds": {
          "type": "number",
          "minimum": 0
        },
        "scanWorkSeconds": {
          "type": "number",
          "minimum": 0
        },
        "resolutionDelaySeconds": {
          "type": "number",
          "minimum": 0
        },
        "promptCapture": {
          "$ref": "#/$defs/promptCaptureSummary"
        }
      },
      "required": [
        "runID",
        "scanSequence",
        "qualityOfService",
        "requestedPeriodSeconds",
        "scanWorkSeconds",
        "resolutionDelaySeconds"
      ]
    },
    "promptCaptureSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captured": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "reservedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "readSeconds": {
          "type": "number",
          "minimum": 0
        },
        "truncated": {
          "type": "integer",
          "minimum": 0,
          "description": "Argument areas exceeding the bounded prompt read; not parsed. Background metadata may retry at full size."
        },
        "capturedWithoutMarker": {
          "type": "integer",
          "minimum": 0,
          "description": "Successful argument reads with no allowlisted session marker; reusable launch observations, not unavailable reads."
        }
      },
      "required": [
        "captured",
        "unavailable",
        "deferred",
        "unsupported",
        "reservedBytes",
        "readSeconds",
        "truncated",
        "capturedWithoutMarker"
      ]
    },
    "processWindowAccounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpuSeconds": {
          "type": "number",
          "minimum": 0
        },
        "recoveredCPUSeconds": {
          "type": "number",
          "minimum": 0
        },
        "pointCandidateCPUSeconds": {
          "type": "number",
          "minimum": 0
        },
        "uncertainCPUSeconds": {
          "type": "number",
          "minimum": 0
        },
        "isHistorical": {
          "type": "boolean"
        },
        "lastObservedAt": {
          "type": "number"
        },
        "lastObservedFootprintBytes": {
          "type": "integer",
          "minimum": 0
        },
        "currentAttribution": {
          "$ref": "#/$defs/attribution"
        },
        "labelChangedInWindow": {
          "type": "boolean",
          "description": "The process CPU spans different observed labels; group CPU follows each frozen contribution, while the row attribution is its last observed label."
        },
        "lastObservedCorroboratedRootSessionID": {
          "type": "string",
          "description": "Root corroborated at the last process observation, independent of whether that observation had a CPU reading."
        }
      },
      "required": [
        "recoveredCPUSeconds",
        "pointCandidateCPUSeconds",
        "uncertainCPUSeconds",
        "isHistorical",
        "lastObservedAt",
        "labelChangedInWindow"
      ]
    },
    "frozenCPUContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runID": {
          "type": "string",
          "format": "uuid"
        },
        "openingScan": {
          "type": "integer",
          "minimum": 0
        },
        "closingScan": {
          "type": "integer",
          "minimum": 0
        },
        "process": {
          "$ref": "#/$defs/processIdentity"
        },
        "newbornOpening": {
          "type": "boolean",
          "description": "Whether the first accepted interval used a verified newborn-zero opening; does not describe every interval in this compact record."
        },
        "verifiedBirth": {
          "type": "number",
          "description": "Verified birth for the first interval when newbornOpening is true."
        },
        "cpuSeconds": {
          "type": "number",
          "minimum": 0
        },
        "startedAt": {
          "type": "number"
        },
        "endedAt": {
          "type": "number"
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "earliestEvidenceObservedAt": {
          "type": "number"
        },
        "latestEvidenceObservedAt": {
          "type": "number"
        },
        "intervalCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of accepted intervals, including accepted zero CPU intervals."
        },
        "missingReadIntervalCount": {
          "type": "integer",
          "minimum": 0
        },
        "executableChangedIntervalCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingEvidenceTimeCount": {
          "type": "integer",
          "minimum": 0
        },
        "corroboratedRootSessionID": {
          "type": "string",
          "description": "Root corroborated at the closing observation and frozen for this contribution; later observations cannot regroup this CPU."
        }
      },
      "required": [
        "runID",
        "openingScan",
        "closingScan",
        "process",
        "newbornOpening",
        "cpuSeconds",
        "startedAt",
        "endedAt",
        "attribution",
        "intervalCount",
        "missingReadIntervalCount",
        "executableChangedIntervalCount",
        "missingEvidenceTimeCount"
      ],
      "description": "Immutable sum of accepted CPU intervals for one process lifetime and frozen category. A category may recur (A to B to A), so endpoint scans and times bound a span that can contain gaps and intervals belonging to other categories. This is not continuous ownership or a per-scan record. Missing reads are counted explicitly; scan distance is not a missing-read count."
    },
    "reportWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runID": {
          "type": "string",
          "format": "uuid"
        },
        "baselineScan": {
          "type": "integer",
          "minimum": 0
        },
        "finalScan": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "type": "number"
        },
        "endedAt": {
          "type": "number"
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frozenCPUContribution"
          }
        },
        "excludedObservationCount": {
          "type": "integer",
          "minimum": 0
        },
        "evictedBaselineCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Exact unless a count range is present; then this scalar is its lower bound."
        },
        "unmeasuredLifetimeCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Exact unless a count range is present; then this scalar is its lower bound."
        },
        "readCoverage": {
          "$ref": "#/$defs/readCoverage"
        },
        "acquisitionCoverage": {
          "$ref": "#/$defs/acquisitionCoverage"
        },
        "collapsedContributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collapsedContribution"
          },
          "description": "Always include these sums with eligible detailed contributions when computing window CPU. Entries explicitly disclose detail loss; an empty array means no such collapse."
        },
        "unmeasuredLifetimeCountRange": {
          "$ref": "#/$defs/lifetimeCountRange"
        },
        "evictedBaselineCountRange": {
          "$ref": "#/$defs/lifetimeCountRange"
        },
        "publicationCoverage": {
          "$ref": "#/$defs/publicationCoverage"
        }
      },
      "required": [
        "runID",
        "baselineScan",
        "finalScan",
        "startedAt",
        "endedAt",
        "contributions",
        "excludedObservationCount",
        "evictedBaselineCount",
        "unmeasuredLifetimeCount",
        "readCoverage",
        "acquisitionCoverage",
        "collapsedContributions",
        "publicationCoverage"
      ]
    },
    "readCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deniedPIDs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "vanishedPIDs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "mismatchedPIDs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "otherFailedPIDs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "unidentifiedFailureObservations": {
          "type": "integer",
          "minimum": 0
        },
        "failedPIDObservations": {
          "type": "integer",
          "minimum": 0
        },
        "scanCount": {
          "type": "integer",
          "minimum": 0
        },
        "maximumFailedPIDsPerScan": {
          "type": "integer",
          "minimum": 0
        },
        "releasedDenied": {
          "$ref": "#/$defs/lifetimeCountRange"
        },
        "releasedVanished": {
          "$ref": "#/$defs/lifetimeCountRange"
        },
        "releasedMismatched": {
          "$ref": "#/$defs/lifetimeCountRange"
        },
        "releasedOther": {
          "$ref": "#/$defs/lifetimeCountRange"
        },
        "releasedAll": {
          "$ref": "#/$defs/lifetimeCountRange"
        },
        "startedAt": {
          "type": "number"
        },
        "endedAt": {
          "type": "number"
        }
      },
      "required": [
        "deniedPIDs",
        "vanishedPIDs",
        "mismatchedPIDs",
        "otherFailedPIDs",
        "unidentifiedFailureObservations",
        "failedPIDObservations",
        "scanCount",
        "maximumFailedPIDsPerScan"
      ],
      "description": "Same-user listing read coverage. PID values are not worker identities. When released ranges exist, union them with retained PID sets using max(lower bounds) and sum(upper bounds); the start/end range qualifies released detail. Observation totals and per-scan maximum remain exact."
    },
    "acquisitionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scanCount": {
          "type": "integer",
          "minimum": 0
        },
        "timedPeriodCount": {
          "type": "integer",
          "minimum": 0
        },
        "overrunCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of periods strictly above 1.5 times the period requested for that scan."
        },
        "maximumGapSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum observed start-to-start acquisition period over the window, including gaps. Omitted when timing is unavailable."
        }
      },
      "required": [
        "scanCount",
        "timedPeriodCount",
        "overrunCount"
      ]
    },
    "lifetimeCountRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "description": "Proven inclusive bounds for distinct observed lifetimes. Reappearance after identity detail was released can widen the range; these are not confirmed exit counts."
    },
    "recentMemoryReading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "scan": {
          "type": "integer",
          "minimum": 0
        },
        "observedAt": {
          "type": "number"
        },
        "evidence": {
          "enum": [
            "marker",
            "inheritedMarker",
            "writerLock",
            "sessionRegistry",
            "runtimeOnly",
            "ambiguous",
            "unknown"
          ]
        },
        "evidenceObservedAt": {
          "type": "number"
        }
      },
      "required": [
        "bytes",
        "scan",
        "observedAt",
        "evidence"
      ]
    },
    "collapsedCategory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "sessionID": {
          "type": "string"
        },
        "rootSessionID": {
          "type": "string"
        },
        "resolution": {
          "enum": [
            "candidate",
            "unresolved",
            "conflicting",
            "shared"
          ]
        },
        "executable": {
          "type": "string"
        },
        "isAgentRuntime": {
          "type": "boolean"
        },
        "agentAssociated": {
          "type": "boolean"
        },
        "categoryDetailsRetained": {
          "type": "boolean"
        },
        "runtime": {
          "$ref": "#/$defs/processIdentity"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "includedInAgentScope": {
          "type": "boolean",
          "description": "Lifetime qualified for agent scope at collapse; does not assign unresolved CPU to an agent."
        }
      },
      "required": [
        "agentAssociated",
        "categoryDetailsRetained",
        "candidates",
        "includedInAgentScope"
      ],
      "description": "A frozen resource category with process identities removed. If categoryDetailsRetained is false, this is a mixed older-work remainder whose original category labels are unavailable; it is not a reassignment to an unknown owner."
    },
    "collapsedContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/collapsedCategory"
        },
        "cpuSeconds": {
          "type": "number",
          "minimum": 0
        },
        "intervalCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingReadIntervalCount": {
          "type": "integer",
          "minimum": 0
        },
        "executableChangedIntervalCount": {
          "type": "integer",
          "minimum": 0
        },
        "excludedObservationCount": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "type": "number"
        },
        "endedAt": {
          "type": "number"
        },
        "maximumFootprint": {
          "$ref": "#/$defs/recentMemoryReading"
        },
        "earliestEvidenceObservedAt": {
          "type": "number"
        },
        "latestEvidenceObservedAt": {
          "type": "number"
        },
        "missingEvidenceTimeCount": {
          "type": "integer",
          "minimum": 0
        },
        "processCount": {
          "$ref": "#/$defs/lifetimeCountRange"
        },
        "workerCount": {
          "$ref": "#/$defs/lifetimeCountRange"
        }
      },
      "required": [
        "category",
        "cpuSeconds",
        "intervalCount",
        "missingReadIntervalCount",
        "executableChangedIntervalCount",
        "excludedObservationCount",
        "startedAt",
        "endedAt",
        "missingEvidenceTimeCount",
        "processCount",
        "workerCount"
      ],
      "description": "Exact eligible CPU sum, interval counts and sampled maximum footprint after delivery pressure released older detail. The time endpoints bound the observations/intervals and may enclose gaps. Current memory is not represented. Process/worker counts are proven ranges; workers exclude adapter-recognised agent runtimes. No process actions or exact-identity inspection are supported."
    },
    "publicationCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceUnitCount": {
          "type": "integer",
          "minimum": 0
        },
        "publishedUnitCount": {
          "type": "integer",
          "minimum": 0
        },
        "coalescedUnitCount": {
          "type": "integer",
          "minimum": 0
        },
        "maximumUnitSpanSeconds": {
          "type": "number",
          "minimum": 0
        },
        "coalescedStartedAt": {
          "description": "Enclosing coalesced range start in monotonic seconds within this acquisition run, using the same time base as window.startedAt.",
          "type": "number"
        },
        "coalescedEndedAt": {
          "description": "Enclosing coalesced range end in monotonic seconds within this acquisition run, using the same time base as window.endedAt.",
          "type": "number"
        }
      },
      "required": [
        "sourceUnitCount",
        "publishedUnitCount",
        "coalescedUnitCount",
        "maximumUnitSpanSeconds"
      ],
      "description": "Original closed units and units admitted to history. Only publication backlog coalesces units; ordinary display aggregation sums these fields without changing time resolution. Coalesced count counts original units involved in merges, not merge operations. Optional time endpoints enclose all coalesced units and may span intervening unmerged units; units are retained or evicted whole."
    }
  }
}
